# Copy this file to .env (in the app/ folder) and fill in your keys, then run: npm run build
# Web3Forms access key (free at https://web3forms.com). Safe to expose; it only sends to your email.
VITE_WEB3FORMS_KEY=
# Admin portal (Supabase, see README "Admin portal"). Leave empty and the site uses the files in src/content:
VITE_SUPABASE_URL=
# The Publishable key (sb_publishable_…) or, on older projects, the anon public key. Never the Secret key.
VITE_SUPABASE_ANON_KEY=
