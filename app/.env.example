# Copy this file to .env (in the app/ folder) and fill in your keys, then run: npm run build
# Web3Forms access key (free at https://web3forms.com). Safe to expose; it only sends to your email.
VITE_WEB3FORMS_KEY=
# Phase 3b (database), not needed for email:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
